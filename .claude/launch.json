{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TYM_TOKEN=local-dev-token",
        "TYM_STATIC_DIR=dist",
        "TYM_DB=server/tym-dev.db",
        "cargo", "run", "--manifest-path", "server/Cargo.toml"
      ],
      "port": 8080
    }
  ]
}
